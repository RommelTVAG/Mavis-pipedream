{
  "name": "@ccteams/pipedream-broker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "node init && tsx scripts/dev-server.ts",
    "issue-code": "tsx scripts/admin.ts issue",
    "list-codes": "tsx scripts/admin.ts list",
    "revoke-code": "tsx scripts/admin.ts revoke",
    "build": "node init && tsc -p tsconfig.build.json",
    "start": "node init && node dist/src/server.js",
    "vault": "tsx scripts/vault-admin.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
