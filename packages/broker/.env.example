# Pipedream project credentials. They live ONLY on the server running this, never on CSA machines
# and never in git.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_PROJECT_ENVIRONMENT=production

# HMAC key for install tokens (broker flow). Generate: openssl rand -hex 32
BROKER_SIGNING_KEY=

# Public URL of this server. Embedded in broker setup codes.
BROKER_PUBLIC_URL=https://pipedream-access.example.com

# --- VPS (src/server.ts) ---
HOST=127.0.0.1
PORT=4021
VAULT_STATE_DIR=/var/lib/mavis-vault/state
# Only these routes are exposed. Default: credentials,health
ROUTES=credentials,health

# --- Vercel instead of a VPS: Upstash Redis / Vercel KV (either naming works) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

LOG_LEVEL=info
